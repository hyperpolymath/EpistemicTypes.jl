#
# STATE.a2ml: project state checkpoint for EpistemicTypes.jl.
#
# Derived on 2026-11-12 from CLADE.a2ml ([status] phase = "incubating"),
# Project.toml (version, description) and the repository itself. It replaces
# the template's own STATE, which this repository carried from its mint.

[metadata]
project = "EpistemicTypes.jl"
version = "0.1.0"
last-updated = "2026-11-12"
# status: active | paused | archived | planned
#   planned: the repo is RESERVED but has not started (minted as a placeholder;
#            equivalent to CLADE [status] phase = "reserved"). It is NOT
#            "paused": paused reads as "was active, stopped".
# AUTHORITY: when this and CLADE [status] phase disagree, CLADE phase is the
# authoritative SCM checkpoint and STATE must be re-derived from it; never
# hand-edit both into agreement (standards#726).
# CLADE phase "incubating" has code under active work, so it maps to "active".
status = "active"

[project-context]
name = "EpistemicTypes.jl"
purpose = "Per-row claims with receipts: standpoint/warrant/projection fibres, epi_status, residual evidence and a safe cross-run merge check for taxonomic pipelines."
# The share of [route-to-mvp] milestones that are complete (3 of 6).
completion-percentage = 50

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "Restore module Epistemic from the design thread, with the two fixes it needed to run", completion = 100 },
  { name = "Behaviour suite with Aqua, JET, format and Julia-floor CI", completion = 100 },
  { name = "Correct the recovered verdicts: no-shared-rank merge, zero-cell depth", completion = 100 },
  { name = "Escape the avec_fibre wire form (needs a format version bump)", completion = 0 },
  { name = "Bind Protoctist.jl through a package extension", completion = 0 },
  { name = "Register in the Julia General registry", completion = 0 },
]

[blockers-and-issues]
# 1. Protoctist.jl defines Standpoint, Warrant and ProjectionY with the same
#    names as this package but different fields, so the planned extension
#    cannot alias them. One package must own the vocabulary first.

[critical-next-actions]
actions = [
  "Decide which package owns Standpoint, Warrant and ProjectionY (this one or Protoctist.jl)",
  "Decide whether can_merge should collapse to the coarsest or the finest shared rank (docs/EXPLAINME.adoc, Current limits)",
  "Percent-encode the avec_fibre wire form and bump its version tag",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
# Related, not parent: Protoctist.jl, Cladistics.jl, EchoTypes.jl, and the
# Agda designs epistemic-types and residual-evidence-types (see README.adoc).
part-of = []
depends-on = []
